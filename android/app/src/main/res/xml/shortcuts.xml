<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- R163: a shortcut published with this category (DirectShare) puts Lists in the Direct Share
         row; the types are those of the "Share" intent filters of QuickAddActivity. The "New task"
         item of the icon menu is that shortcut, not a static one. -->
    <share-target android:targetClass="org.evsyukov.lists.QuickAddActivity">
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/*" />
        <data android:mimeType="application/*" />
        <category android:name="org.evsyukov.lists.category.NEW_TASK" />
    </share-target>
</shortcuts>
