# Copy to .env next to compose.yaml and fill in. Git ignores .env.
LISTS_VERSION=0.5.2
LISTS_PORT=8080
LISTS_WEB_PASSWORD=

# WebDAV sync, see docs/self-hosting.md; leave LISTS_SYNC=off to keep the data on the server only.
LISTS_SYNC=off
LISTS_SYNC_URL=
LISTS_SYNC_USER=
LISTS_SYNC_PASSWORD=

# ntfy server through which other devices ask this one to sync at once.
LISTS_PUSH_SERVER=
