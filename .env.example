# Copy to .env next to compose.yaml and fill in. Git ignores .env.
LISTS_VERSION=0.7.2
LISTS_PORT=8080
LISTS_WEB_PASSWORD=

# WebDAV sync, see docs/self-hosting.md; leave LISTS_SYNC=off to keep the data on the server only.
LISTS_SYNC=off
LISTS_SYNC_URL=
LISTS_SYNC_USER=
LISTS_SYNC_PASSWORD=
# The passphrase of a storage encrypted from the app on a Mac or a phone; empty for one in the clear.
LISTS_SYNC_PASSPHRASE=

# ntfy server through which other devices ask this one to sync at once.
LISTS_PUSH_SERVER=

# The address the browser sees (https://…), and the contact push services see for notifications.
LISTS_WEB_URL=
LISTS_VAPID_SUBJECT=

# Attachment limits of the web server, in megabytes; 0 disables one.
LISTS_MAX_FILE_MB=512
LISTS_MAX_TASK_MB=2048
